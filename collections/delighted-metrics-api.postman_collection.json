          "request": {
            "name": "Get metrics",
            "description": {
              "content": "Returns NPS and satisfaction metrics for the project. By default returns core metrics; optionally returns metrics grouped by delivery channel.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "metrics.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<integer>",
                  "description": "Unix timestamp to restrict metrics to those created on or after this time."
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<integer>",
                  "description": "Unix timestamp to restrict metrics to those created on or before this time."
                },
                {
                  "disabled": false,
                  "key": "trend",
                  "value": "<string>",
                  "description": "Restricts metrics to a specific trend using its ID."
                },
                {
                  "disabled": false,
                  "key": "groups[]",
                  "value": "<string>",
                  "description": "Metric groups to return. Options: core, email, kiosk, link, sms, web. Default is core."
                },
                {
                  "disabled": false,
                  "key": "groups[]",
